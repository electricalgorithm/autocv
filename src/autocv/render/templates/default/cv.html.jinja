<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ cv.person.name }}</title>
<style>{{ css|safe }}</style>
</head>
<body>

{% macro icon(name) -%}
{%- if name == "mail" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
{%- elif name == "phone" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
{%- elif name == "pin" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
{%- elif name == "calendar" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M8 2v4"/><path d="M16 2v4"/><path d="M3 10h18"/></svg>
{%- elif name == "linkedin" -%}
<svg viewBox="0 0 24 24"><text x="12" y="17" text-anchor="middle" font-size="13" font-weight="700" fill="white" font-family="Liberation Sans, Arial, sans-serif">in</text></svg>
{%- elif name == "github" -%}
<svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="8" fill="white"/><polygon points="7,8 9,4 10,7" fill="white"/><polygon points="17,8 15,4 14,7" fill="white"/><circle cx="9" cy="13" r="1.3" fill="black"/><circle cx="15" cy="13" r="1.3" fill="black"/></svg>
{%- elif name == "link" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
{%- elif name == "scholar" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10L12 4 2 10l10 6 10-6z"/><path d="M6 12.5V18c0 1.5 2.7 3 6 3s6-1.5 6-3v-5.5"/></svg>
{%- elif name == "flag" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
{%- elif name == "ext" -%}
<svg class="ext-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
{%- endif -%}
{%- endmacro %}

{% macro badge(name) -%}
<span class="badge">{{ icon(name) }}</span>
{%- endmacro %}

{% macro entry_heading(bold_text, url, plain_text) -%}
<span class="bold">{{ bold_text }}</span>
{%- if plain_text %},
  {%- if url %} <a href="{{ url }}">{{ plain_text }}</a>{{ icon("ext") }}
  {%- else %} {{ plain_text }}
  {%- endif %}
{%- elif url %} <a href="{{ url }}"></a>{{ icon("ext") }}
{%- endif %}
{%- endmacro %}

<div class="header">
  <div class="header-text">
    <h1><span class="name">{{ cv.person.name }}</span><span class="headline">{{ cv.person.headline }}</span></h1>

    <div class="contact-row">
      <span class="contact-item">{{ badge("mail") }}{{ cv.contact.email }}</span>
      <span class="contact-item">{{ badge("phone") }}{{ cv.contact.phone }}</span>
      <span class="contact-item">{{ badge("pin") }}{{ cv.contact.location }}</span>
    </div>

    {% if cv.person.birth_date or cv.contact.linkedin or cv.contact.github %}
    <div class="contact-row">
      {% if cv.person.birth_date %}<span class="contact-item">{{ badge("calendar") }}{{ cv.person.birth_date|format_date }}</span>{% endif %}
      {% if cv.contact.linkedin %}<span class="contact-item">{{ badge("linkedin") }}<a href="https://www.linkedin.com/in/{{ cv.contact.linkedin }}">in/{{ cv.contact.linkedin }}</a></span>{% endif %}
      {% if cv.contact.github %}<span class="contact-item">{{ badge("github") }}<a href="https://github.com/{{ cv.contact.github }}">{{ cv.contact.github }}</a></span>{% endif %}
    </div>
    {% endif %}

    {% if cv.contact.website or cv.contact.scholar or cv.person.citizenships or cv.person.work_authorization %}
    <div class="contact-row">
      {% if cv.contact.website %}<span class="contact-item">{{ badge("link") }}<a href="https://{{ cv.contact.website }}">{{ cv.contact.website }}</a></span>{% endif %}
      {% if cv.contact.scholar %}<span class="contact-item">{{ badge("scholar") }}<a href="{{ cv.contact.scholar }}">Google Scholar</a></span>{% endif %}
      {% if cv.person.citizenships or cv.person.work_authorization %}
      <span class="contact-item">{{ badge("flag") }}{{ cv.person.citizenships|join(", ") }}{% if cv.person.citizenships and cv.person.work_authorization %} - {% endif %}{{ cv.person.work_authorization or "" }}</span>
      {% endif %}
    </div>
    {% endif %}
  </div>
  {% if photo_uri %}<img class="photo" src="{{ photo_uri }}" alt="">{% endif %}
</div>

<p class="summary">{{ cv.summary }}</p>

{% if cv.experience %}
<section>
  <h2>Professional Experience</h2>
  {% for e in cv.experience %}
  <div class="entry">
    <div class="entry-side">
      <div class="entry-date">{{ e.start|format_month }} &ndash; {{ e.end|format_month }}</div>
      <div class="entry-location">{{ e.location }}</div>
    </div>
    <div class="entry-main">
      <p class="entry-heading">{{ entry_heading(e.title, e.organization_url, e.organization) }}</p>
      {% if e.summary %}<p class="entry-body">{{ e.summary }}</p>{% endif %}
      {% if e.highlights %}
      <ul class="entry-bullets">
        {% for h in e.highlights %}<li>{{ h }}</li>{% endfor %}
      </ul>
      {% endif %}
      {% if e.keywords %}<p class="entry-tags">{{ e.keywords|join(", ") }}</p>{% endif %}
    </div>
  </div>
  {% endfor %}
</section>
{% endif %}

{% if cv.education %}
<section>
  <h2>Education</h2>
  {% for ed in cv.education %}
  <div class="entry">
    <div class="entry-side">
      <div class="entry-date">{{ ed.start|format_month }} &ndash; {{ ed.end|format_month }}</div>
      <div class="entry-location">{{ ed.location }}</div>
    </div>
    <div class="entry-main">
      <p class="entry-heading">{{ entry_heading(ed.degree, ed.institution_url, ed.institution) }}</p>
      {% if ed.detail %}<p class="entry-detail">{{ ed.detail }}</p>{% endif %}
    </div>
  </div>
  {% endfor %}
</section>
{% endif %}

{% if cv.skills %}
<section>
  <h2>Skills</h2>
  <p class="skills-list">{{ cv.skills|join(" • ") }}</p>
</section>
{% endif %}

{% if cv.certifications %}
<section>
  <h2>Certifications</h2>
  <p class="skills-list">{{ cv.certifications|join(" • ") }}</p>
</section>
{% endif %}

{% if cv.publications %}
<section>
  <h2>Publications</h2>
  {% for pub in cv.publications %}
  <div class="entry">
    <div class="entry-side">
      <div class="entry-date">{{ pub.date|format_month }}</div>
    </div>
    <div class="entry-main">
      <p class="entry-heading">{{ entry_heading(pub.title, pub.url, pub.venue) }}</p>
    </div>
  </div>
  {% endfor %}
</section>
{% endif %}

{% if cv.projects %}
<section>
  <h2>Open Source Projects</h2>
  {% for p in cv.projects %}
  <div class="entry">
    <div class="entry-side">
      <div class="entry-date">{{ p.categories|join(", ") }}</div>
    </div>
    <div class="entry-main">
      <p class="entry-heading">{{ entry_heading(p.title, p.url, p.detail or "") }}</p>
      {% if p.stack %}<p class="entry-tags">{{ p.stack|join(", ") }}</p>{% endif %}
    </div>
  </div>
  {% endfor %}
</section>
{% endif %}

{% if cv.references or cv.languages %}
<div class="two-col">
  {% if cv.references %}
  <section class="col">
    <h2>References</h2>
    {% for r in cv.references %}
    <p class="reference">
      <span class="bold">{{ r.name }}</span> <span class="italic">, {{ r.title }},</span><br>
      {{ r.organization }}<br>
      {{ r.email }}
    </p>
    {% endfor %}
  </section>
  {% endif %}
  {% if cv.languages %}
  <section class="col">
    <h2>Languages</h2>
    {% for lang in cv.languages %}
    <p class="language"><span class="bold">{{ lang.name }}</span> &mdash; {{ lang.level }}</p>
    {% endfor %}
  </section>
  {% endif %}
</div>
{% endif %}

</body>
</html>
